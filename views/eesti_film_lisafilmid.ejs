<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Tanel Leetmaa, veebiprogrammeerimine</title>
</head>
<body>
	<img src="../pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
	<h1>Lisa film</h1>
	<p>Siin lehel saab andmebaasi lisada Eesti filme.</p>
	<hr>
	<ul>
		<li><a href="/">Avalehele</a></li>
		<li><a href="/eestifilm">Eesti filmi avaleht</a></li>
	</ul>
	<hr>
	<form method="POST">
		<label for="titleInput">Filmi pealkiri</label>
		<input id="titleInput" name="titleInput" type="text" placeholder="Pealkiri" value="<%= titleInput %>" required>
		<br>
		<label for="yearInput">Valmimisaasta</label>
		<input id="yearInput" name="yearInput" type="number" placeholder="Aasta" value="<%= yearInput %>" required>
		<br>
		<label for="durationInput">Kestus minutites</label>
		<input id="durationInput" name="durationInput" type="number" placeholder="Minutid" value="<%= durationInput %>" required>
		<br>
		<label for="descriptionInput">Kirjeldus</label>
		<input id="descriptionInput" name="descriptionInput" type="text" placeholder="Kirjeldus" value="<%= descriptionInput %>">
		<br>
		<input id="movieSubmit" name="movieSubmit" type="submit" value="Salvesta">
	</form>
	<p><%= notice %></p>
</body>
</html>
