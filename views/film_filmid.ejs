<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Tanel Leetmaa, veebiprogrammeerimine</title>
</head>
<body>
	<img src="../pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
	<h1>Eesti film</h1>
	<p>Siit leiab infot Eesti filmide kohta.</p>
	<ul>
		<li><a href="/">Avalehele</a></li>
		<li><a href="/eestifilm">Eesti filmi avalehele</a></li>
	</ul>
	<hr>
	<h2>Siit andmebaasist leitavad filmid</h2>
	<ol>
		<% movieList.forEach(function(movie){ %>
		<li><%= movie.title %> (<%= movie.release_year %>), <%= movie.duration_minutes %> min</li>
		<% }); %>
	</ol>
</body>
</html>
