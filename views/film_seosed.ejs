<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Tanel Leetmaa, veebiprogrammeerimine</title>
</head>
<body>
	<img src="../pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
	<h1>Eesti film</h1>
	<p>Siit leiab infot isikute, filmide ja ametite seoste kohta.</p>
	<ul>
		<li><a href="/">Avalehele</a></li>
		<li><a href="/eestifilm">Eesti filmi avalehele</a></li>
		<li><a href="/eestifilm/seosed_lisa">Lisa seos</a></li>
	</ul>
	<hr>
	<h2>Siit andmebaasist leitavad seosed</h2>
	<ol>
		<% seosList.forEach(function(seos){ %>
		<li><%= seos.first_name %> <%= seos.last_name %>, <%= seos.movie_title %> (<%= seos.release_year %>), <%= seos.profession_title %><% if(seos.character_name){ %>, tegelaskuju: <%= seos.character_name %><% } %></li>
		<% }); %>
	</ol>
</body>
</html>
