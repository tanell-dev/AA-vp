<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Tanel Leetmaa, veebiprogrammeerimine</title>
</head>
<body>
	<img src="../pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
	<h1>Lisa seos</h1>
	<p>Siin lehel saab andmebaasi lisada seose isiku, filmi ja ameti vahel.</p>
	<hr>
	<ul>
		<li><a href="/">Avalehele</a></li>
		<li><a href="/eestifilm">Eesti filmi avaleht</a></li>
		<li><a href="/eestifilm/seosed">Seoste nimekiri</a></li>
	</ul>
	<hr>
	<form method="POST">
		<label for="personInput">Isik</label>
		<select id="personInput" name="personInput">
			<option<% if(!personInput){ %> selected<% } %> disabled>Vali isik</option>
			<% personList.forEach(function(person){ %>
			<option value="<%= person.id %>"<% if(String(personInput) === String(person.id)){ %> selected<% } %>><%= person.first_name %> <%= person.last_name %></option>
			<% }); %>
		</select>
		<br>
		<label for="movieInput">Film</label>
		<select id="movieInput" name="movieInput">
			<option<% if(!movieInput){ %> selected<% } %> disabled>Vali film</option>
			<% movieList.forEach(function(movie){ %>
			<option value="<%= movie.id %>"<% if(String(movieInput) === String(movie.id)){ %> selected<% } %>><%= movie.title %> (<%= movie.release_year %>)</option>
			<% }); %>
		</select>
		<br>
		<label for="professionInput">Amet</label>
		<select id="professionInput" name="professionInput">
			<option<% if(!professionInput){ %> selected<% } %> disabled>Vali amet</option>
			<% professionList.forEach(function(profession){ %>
			<option value="<%= profession.id %>"<% if(String(professionInput) === String(profession.id)){ %> selected<% } %>><%= profession.title %></option>
			<% }); %>
		</select>
		<br>
		<label for="characterInput">Tegelaskuju (kui on)</label>
		<input id="characterInput" name="characterInput" type="text" placeholder="Tegelaskuju" value="<%= characterInput %>">
		<br>
		<input id="seosSubmit" name="seosSubmit" type="submit" value="Salvesta">
	</form>
	<p><%= notice %></p>
</body>
</html>
